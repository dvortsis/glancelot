# REL-01: configure-time provenance rules, on the scratch project in tests/provenance/probe (no Qt, no compiler).
#   cmake -DGLANCELOT_REPO=<checkout> -DWORK=<empty scratch dir> -DGENERATOR=<CMake generator> [-DGIT=<git>]
#         -P tests/provenance/run_configure_tests.cmake
# Each case configures a copy of the probe in its own directory under WORK. A copy outside a work tree of its own has no
# SHA (it may sit inside the Glancelot checkout's build tree; that host SHA must not be used). With Git, one case makes a
# real repository and checks the SHA, and that the build-time step follows a new commit without rewriting otherwise.
cmake_minimum_required(VERSION 3.24)
foreach(required GLANCELOT_REPO WORK GENERATOR)
  if(NOT ${required})
    message(FATAL_ERROR "run_configure_tests.cmake needs -D${required}=...")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
set(failures 0)
set(sha40 "0123456789ABCDEF0123456789ABCDEF01234567")
string(TOLOWER "${sha40}" sha40_lower)

# check(<message> <condition...>): the condition words follow the message, as if() takes them.
function(check message)
  if(NOT (${ARGN}))
    message(SEND_ERROR "FAIL: ${message}")
    math(EXPR count "${failures} + 1")
    set(failures ${count} PARENT_SCOPE)
  else()
    message(STATUS "ok: ${message}")
  endif()
endfunction()

# configure(<case> <expect: pass|fail> [cache args...]) -> ${case}_output, ${case}_values (generated file text)
function(configure case expect)
  set(src "${WORK}/${case}/src")
  set(bin "${WORK}/${case}/build")
  if(NOT EXISTS "${src}/CMakeLists.txt")
    file(COPY "${GLANCELOT_REPO}/tests/provenance/probe/CMakeLists.txt" DESTINATION "${src}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${src}" -B "${bin}" -G "${GENERATOR}" "-DGLANCELOT_REPO=${GLANCELOT_REPO}" ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(${case}_output "${out}${err}" PARENT_SCOPE)
  set(values "")
  if(EXISTS "${bin}/build_info_values.cpp")
    file(READ "${bin}/build_info_values.cpp" values)
  endif()
  set(${case}_values "${values}" PARENT_SCOPE)
  if(expect STREQUAL "pass")
    set(ok FALSE)
    if(result EQUAL 0)
      set(ok TRUE)
    endif()
  else()
    set(ok TRUE)
    if(result EQUAL 0)
      set(ok FALSE)
    endif()
  endif()
  if(NOT ok)
    message(STATUS "${case} output:\n${out}${err}")
  endif()
  check("${case}: configure is expected to ${expect}" ok)
  set(failures ${failures} PARENT_SCOPE)
endfunction()

macro(expect_value case field value)
  string(FIND "${${case}_values}" "${field}[] = \"${value}\";" at)
  check("${case}: ${field} is \"${value}\"" at GREATER -1)
endmacro()
macro(expect_output case text)
  string(FIND "${${case}_output}" "${text}" at)
  check("${case}: output names \"${text}\"" at GREATER -1)
endmacro()

# Replaces the build time in a generated file, keeping its provenance key: the sentinel stays only if nothing rewrites it.
function(mark_unchanged file)
  file(READ "${file}" text)
  string(REGEX REPLACE "builtAt\\[\\] = \"[^\"]*\"" "builtAt[] = \"sentinel\"" text "${text}")
  file(WRITE "${file}" "${text}")
endfunction()

set(no_git "-DGIT_EXECUTABLE=${WORK}/no-such-git")

# A local build without Git configures and records "unknown".
configure(local_without_git pass ${no_git})
expect_value(local_without_git sha unknown)
expect_value(local_without_git kind local)
expect_value(local_without_git version 1.2.3)
# release and rc builds fail at configure time without a SHA, and say how to pass one.
configure(release_without_sha fail ${no_git} -DGLANCELOT_BUILD_KIND=release)
expect_output(release_without_sha "This release build must record its Git SHA")
expect_output(release_without_sha "GLANCELOT_GIT_SHA")
configure(rc_without_sha fail ${no_git} -DGLANCELOT_VERSION_SUFFIX=-rc.1)
expect_output(rc_without_sha "This rc build must record its Git SHA")
# A dev build without a SHA configures, warns and records "unknown".
configure(dev_without_sha pass ${no_git} -DGLANCELOT_VERSION_SUFFIX=-dev.3)
expect_value(dev_without_sha kind dev)
expect_value(dev_without_sha version 1.2.3-dev.3)
expect_value(dev_without_sha sha unknown)
expect_output(dev_without_sha "has no Git SHA")
# An explicit SHA (Docker, source archive) makes a release; it is stored lowercase.
configure(release_with_sha pass ${no_git} -DGLANCELOT_BUILD_KIND=release "-DGLANCELOT_GIT_SHA=${sha40}")
expect_value(release_with_sha sha "${sha40_lower}")
expect_value(release_with_sha kind release)
expect_value(release_with_sha version 1.2.3)
configure(rc_with_sha pass ${no_git} -DGLANCELOT_VERSION_SUFFIX=-rc.12 "-DGLANCELOT_GIT_SHA=${sha40}")
expect_value(rc_with_sha kind rc)
expect_value(rc_with_sha version 1.2.3-rc.12)
# Malformed values are refused.
configure(bad_suffix fail ${no_git} -DGLANCELOT_VERSION_SUFFIX=rc1)
expect_output(bad_suffix "GLANCELOT_VERSION_SUFFIX is \"rc1\"")
configure(leading_zero fail ${no_git} -DGLANCELOT_VERSION_SUFFIX=-rc.01 "-DGLANCELOT_GIT_SHA=${sha40}")
expect_output(leading_zero "GLANCELOT_VERSION_SUFFIX is \"-rc.01\"")
configure(bad_kind fail ${no_git} -DGLANCELOT_BUILD_KIND=nightly)
configure(release_with_suffix fail ${no_git} -DGLANCELOT_BUILD_KIND=release -DGLANCELOT_VERSION_SUFFIX=-rc.1 "-DGLANCELOT_GIT_SHA=${sha40}")
configure(rc_without_suffix fail ${no_git} -DGLANCELOT_BUILD_KIND=rc "-DGLANCELOT_GIT_SHA=${sha40}")
configure(dev_with_rc_suffix fail ${no_git} -DGLANCELOT_BUILD_KIND=dev -DGLANCELOT_VERSION_SUFFIX=-rc.1)
configure(short_sha fail ${no_git} -DGLANCELOT_BUILD_KIND=release -DGLANCELOT_GIT_SHA=0123456)
expect_output(short_sha "must be a full 40- or 64-character")

# SOURCE_DATE_EPOCH fixes the build time; reconfiguring the same inputs keeps the file (and its time) unchanged.
set(ENV{SOURCE_DATE_EPOCH} 86400)
configure(reproducible pass ${no_git})
expect_value(reproducible builtAt 1970-01-02T00:00:00Z)
# A sentinel in place of the build time survives a reconfigure only if the file is not rewritten (no timing involved).
mark_unchanged("${WORK}/reproducible/build/build_info_values.cpp")
configure(reproducible pass ${no_git})
expect_value(reproducible builtAt sentinel)
set(ENV{SOURCE_DATE_EPOCH} 172800)
configure(reproducible pass ${no_git})
expect_value(reproducible builtAt 1970-01-03T00:00:00Z)
unset(ENV{SOURCE_DATE_EPOCH})

# With Git: a repository of the probe's own. A release takes HEAD; the build step follows a new commit.
if(GIT)
  set(src "${WORK}/git_release/src")
  file(COPY "${GLANCELOT_REPO}/tests/provenance/probe/CMakeLists.txt" DESTINATION "${src}")
  set(ENV{GIT_AUTHOR_NAME} "Provenance Test")
  set(ENV{GIT_AUTHOR_EMAIL} "provenance@example.invalid")
  set(ENV{GIT_COMMITTER_NAME} "Provenance Test")
  set(ENV{GIT_COMMITTER_EMAIL} "provenance@example.invalid")
  set(git_quiet -c init.defaultBranch=main -c commit.gpgsign=false -c core.autocrlf=false)
  execute_process(COMMAND "${GIT}" ${git_quiet} init -q "${src}" RESULT_VARIABLE r1)
  execute_process(COMMAND "${GIT}" ${git_quiet} -C "${src}" add CMakeLists.txt RESULT_VARIABLE r2)
  execute_process(COMMAND "${GIT}" ${git_quiet} -C "${src}" commit -q -m first RESULT_VARIABLE r3)
  execute_process(COMMAND "${GIT}" -C "${src}" rev-parse HEAD OUTPUT_VARIABLE head1 OUTPUT_STRIP_TRAILING_WHITESPACE)
  check("git_release: scratch repository created" r1 EQUAL 0 AND r2 EQUAL 0 AND r3 EQUAL 0)
  configure(git_release pass "-DGIT_EXECUTABLE=${GIT}" -DGLANCELOT_BUILD_KIND=release)
  expect_value(git_release sha "${head1}")
  file(WRITE "${src}/note.txt" "second\n")
  execute_process(COMMAND "${GIT}" ${git_quiet} -C "${src}" add note.txt)
  execute_process(COMMAND "${GIT}" ${git_quiet} -C "${src}" commit -q -m second RESULT_VARIABLE r4)
  execute_process(COMMAND "${GIT}" -C "${src}" rev-parse HEAD OUTPUT_VARIABLE head2 OUTPUT_STRIP_TRAILING_WHITESPACE)
  check("git_release: second commit made" r4 EQUAL 0 AND NOT head1 STREQUAL head2)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/git_release/build" --target probe_refresh RESULT_VARIABLE r5)
  file(READ "${WORK}/git_release/build/build_info_values.cpp" git_release_values)
  check("git_release: the build-time refresh runs" r5 EQUAL 0)
  expect_value(git_release sha "${head2}")
  # A source tree that is only a subdirectory of another repository has no SHA of its own: never its host's, and a release
  # from it fails. The vendored copy sits inside the scratch repository above.
  set(vendored "${src}/vendored")
  file(COPY "${GLANCELOT_REPO}/tests/provenance/probe/CMakeLists.txt" DESTINATION "${vendored}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${vendored}" -B "${WORK}/vendored/build" -G "${GENERATOR}"
    "-DGLANCELOT_REPO=${GLANCELOT_REPO}" "-DGIT_EXECUTABLE=${GIT}" RESULT_VARIABLE r7 OUTPUT_QUIET ERROR_QUIET)
  file(READ "${WORK}/vendored/build/build_info_values.cpp" vendored_values)
  check("vendored: a local build inside another repository configures" r7 EQUAL 0)
  expect_value(vendored sha unknown)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${vendored}" -B "${WORK}/vendored_release/build" -G "${GENERATOR}"
    "-DGLANCELOT_REPO=${GLANCELOT_REPO}" "-DGIT_EXECUTABLE=${GIT}" -DGLANCELOT_BUILD_KIND=release
    RESULT_VARIABLE r8 OUTPUT_VARIABLE vendored_release_output ERROR_VARIABLE vendored_release_error)
  set(vendored_release_output "${vendored_release_output}${vendored_release_error}")
  check("vendored_release: a release inside another repository fails" NOT r8 EQUAL 0)
  expect_output(vendored_release "not the root of its own")
  # Building again with no new commit leaves the file untouched, so nothing recompiles or relinks.
  mark_unchanged("${WORK}/git_release/build/build_info_values.cpp")
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/git_release/build" --target probe_refresh RESULT_VARIABLE r6)
  file(READ "${WORK}/git_release/build/build_info_values.cpp" git_release_values)
  check("git_release: the second refresh runs" r6 EQUAL 0)
  expect_value(git_release builtAt sentinel)
else()
  message(STATUS "skip: Git not found; the repository cases did not run")
endif()

if(failures GREATER 0)
  message(FATAL_ERROR "${failures} provenance configure check(s) failed")
endif()
message(STATUS "all provenance configure checks passed")
