+            if (folderEvery && i % folderEvery == 0) return QString("dir%1").arg(rows - i, 6, 10, QChar('0'));
+            return QString("f%1.txt").arg(rows - i, 6, 10, QChar('0'));
+        };
+        SeamScope seam(&folder, 2048);
+        Harness h; QVERIFY(h.window); h.window->resize(1180, 780);
+        h.viewer.setFilmstripVisible(false);
+        h.viewer.open(media.path(0));
+        h.viewer.trigger("grid");
+        QTRY_VERIFY_WITH_TIMEOUT(h.viewer.imageReady() && h.fileGrid.count() == 2048 && h.fileGrid.arriving(), 15000);
+        if (withSelection) h.fileGrid.select(10);
+        qint64 worst = 0, last = 0; int ticks = 0;
