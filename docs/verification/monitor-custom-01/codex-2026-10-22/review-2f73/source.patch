+struct MonitorCustomization::Private {
+    MonitorCustomization* q;
+    DisplayManager* displays;
+    PaneLayout* panes;
+    QPointer<QQuickWindow> controller,outputWindow;
+    QPointer<QScreen> sessionScreen;
+    QVariantMap lastAppliedOptions;
